# Local-only API credentials for the site data updaters (npm run update).
# Copy to .env and fill in. .env and .env.local are gitignored: never commit
# these values and never add them to GitHub. The updaters write plain display
# data to public/events.json and public/videos.json, which is all the site serves.

# start.gg personal access token, used to discover the next tournament.
STARTGG_TOKEN=

# YouTube Data API v3 key (an API key, not OAuth), used to find the newest
# Basement Brawl event playlist.
YOUTUBE_API_KEY=

# Optional. When empty the updaters resolve the channel from the @KWTekken handle.
YOUTUBE_CHANNEL_ID=
