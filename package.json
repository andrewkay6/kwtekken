{
  "name": "kwtekken",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "update": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/update-all.mjs",
    "update:events": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/update-events.mjs",
    "update:videos": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/update-videos.mjs",
    "check:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/live-check.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "lenis": "^1.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "react-refresh": "0.14.2",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
